PROJECT_NAME=Aegis Backend
DATABASE_URL=postgresql://user:password@db:5432/aegis
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=template
LLM_ENABLE_REAL_CALLS=false
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.3
LLM_RETRY_ATTEMPTS=1
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_REQUEST_HARD_MAX_TOKENS=2000
LLM_TASK_TOTAL_TOKEN_SOFT_LIMIT=6000
LLM_TASK_TOTAL_TOKEN_HARD_LIMIT=10000
LLM_ENABLE_COST_ESTIMATION=true
LLM_COST_PER_1M_INPUT_TOKENS=
LLM_COST_PER_1M_OUTPUT_TOKENS=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Aegis
RAG_ENABLED=true
RAG_TOP_K=5
RAG_MIN_SCORE=0.0
RAG_MAX_CONTEXT_CHARS=4000
RAG_TRACE_SNIPPET_CHARS=300

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
VITE_API_URL=/api/v1
